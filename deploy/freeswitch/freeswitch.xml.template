<?xml version="1.0" encoding="UTF-8"?>
<document type="freeswitch/xml">
  <X-PRE-PROCESS cmd="set" data="domain=@SIP_DOMAIN@"/>
  <section name="configuration" description="Demo FreeSWITCH">
    <configuration name="modules.conf" description="Modules">
      <modules>
        <load module="mod_console"/>
        <load module="mod_logfile"/>
        <load module="mod_commands"/>
        <load module="mod_dptools"/>
        <load module="mod_dialplan_xml"/>
        <load module="mod_sofia"/>
        <load module="mod_event_socket"/>
        <load module="mod_tone_stream"/>
      </modules>
    </configuration>
    <configuration name="switch.conf" description="Core">
      <settings>
        <param name="loglevel" value="info"/>
        <param name="max-sessions" value="20"/>
        <param name="sessions-per-second" value="5"/>
        <param name="rtp-start-port" value="10000"/>
        <param name="rtp-end-port" value="10099"/>
      </settings>
    </configuration>
    <configuration name="console.conf" description="Console">
      <mappings><map name="all" value="console,debug,info,notice,warning,err,crit,alert"/></mappings>
      <settings><param name="colorize" value="false"/><param name="loglevel" value="info"/></settings>
    </configuration>
    <configuration name="acl.conf" description="Access lists">
      <network-lists>
        <list name="demo-esl" default="deny">
          <node type="allow" cidr="127.0.0.0/8"/>
          <node type="allow" cidr="@ESL_ALLOWED_CIDR@"/>
        </list>
      </network-lists>
    </configuration>
    <configuration name="event_socket.conf" description="ESL">
      <settings>
        <param name="listen-ip" value="@ESL_LISTEN_IP@"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="@FREESWITCH_ESL_PASSWORD@"/>
        <param name="apply-inbound-acl" value="demo-esl"/>
      </settings>
    </configuration>
    <configuration name="sofia.conf" description="SIP">
      <global_settings><param name="log-level" value="0"/></global_settings>
      <profiles>
        <profile name="internal">
          <aliases/>
          <gateways/>
          <domains><domain name="all" alias="true" parse="false"/></domains>
          <settings>
            <param name="sip-ip" value="$${local_ip_v4}"/>
            <param name="rtp-ip" value="$${local_ip_v4}"/>
            <param name="ext-sip-ip" value="@FREESWITCH_PUBLIC_IP@"/>
            <param name="ext-rtp-ip" value="@FREESWITCH_PUBLIC_IP@"/>
            <param name="sip-port" value="5060"/>
            <param name="dialplan" value="XML"/>
            <param name="context" value="blocked"/>
            <param name="auth-calls" value="true"/>
            <param name="accept-blind-reg" value="false"/>
            <param name="force-register-domain" value="$${domain}"/>
            <param name="force-register-db-domain" value="$${domain}"/>
            <param name="challenge-realm" value="$${domain}"/>
            <param name="inbound-codec-prefs" value="PCMU,PCMA"/>
            <param name="outbound-codec-prefs" value="PCMU,PCMA"/>
            <param name="inbound-codec-negotiation" value="generous"/>
            <param name="rtp-timeout-sec" value="300"/>
            <param name="rtp-hold-timeout-sec" value="600"/>
            <param name="manage-presence" value="false"/>
          </settings>
        </profile>
        <profile name="external">
          <aliases/>
          <gateways/>
          <domains><domain name="all" alias="false" parse="false"/></domains>
          <settings>
            <param name="sip-ip" value="$${local_ip_v4}"/>
            <param name="rtp-ip" value="$${local_ip_v4}"/>
            <param name="ext-sip-ip" value="@FREESWITCH_PUBLIC_IP@"/>
            <param name="ext-rtp-ip" value="@FREESWITCH_PUBLIC_IP@"/>
            <param name="sip-port" value="5080"/>
            <param name="dialplan" value="XML"/>
            <param name="context" value="blocked"/>
            <param name="auth-calls" value="true"/>
            <param name="disable-register" value="true"/>
            <param name="inbound-codec-prefs" value="PCMU,PCMA"/>
            <param name="outbound-codec-prefs" value="PCMU,PCMA"/>
            <param name="rtp-timeout-sec" value="300"/>
            <param name="rtp-hold-timeout-sec" value="600"/>
          </settings>
        </profile>
      </profiles>
    </configuration>
  </section>
  <section name="dialplan" description="No unsolicited dialing">
    <context name="blocked">
      <extension name="reject"><condition><action application="hangup" data="CALL_REJECTED"/></condition></extension>
    </context>
  </section>
  <section name="directory" description="Demo extensions">
    <domain name="$${domain}">
      <params>
        <param name="dial-string" value="{presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(${dialed_user}@${dialed_domain})}"/>
      </params>
      <groups><group name="default"><users>
        <user id="1001">
          <params><param name="password" value="@SIP_EXTENSION_PASSWORD@"/></params>
          <variables><variable name="user_context" value="blocked"/></variables>
        </user>
      </users></group></groups>
    </domain>
  </section>
</document>
