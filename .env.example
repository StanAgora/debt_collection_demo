# Copy to .env. Compose reads it automatically; npm start does not.
# Use the public IPv4 of your Linux server for real Agora RTP traffic.
FREESWITCH_PUBLIC_IP=YOUR_SERVER_PUBLIC_IPV4
SIP_DOMAIN=demo.local
# Generate separate random values, e.g. openssl rand -hex 24 (letters/digits only).
FREESWITCH_ESL_PASSWORD=REPLACE_WITH_RANDOM_ESL_PASSWORD
SIP_EXTENSION_PASSWORD=REPLACE_WITH_RANDOM_EXTENSION_PASSWORD
AGORA_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_WEBHOOK_TOKEN
# Public community image, amd64 also works via emulation on Apple Silicon.
# After validating the image, pin its repo digest for repeatable deployments.
FREESWITCH_IMAGE=safarov/freeswitch@sha256:f156e01a96d48944078ed7f0e24304be63ea15f6466cf607a0aeb6cb47761da7
FREESWITCH_PLATFORM=linux/amd64
DEMO_SUBNET=172.30.86.0/24
ESL_ALLOWED_CIDR=172.30.86.0/24
